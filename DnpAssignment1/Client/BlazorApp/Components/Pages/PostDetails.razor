@page "/posts/{Id:int}"
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<PageTitle>Post</PageTitle>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}
else if (post is null)
{
    <p>Loading...</p>
}
else
{
    <h3>@post.Title</h3>
    <p class="text-muted">by @AuthorName(post.UserId)</p>
    <p style="white-space: pre-wrap">@post.Body</p>

    <hr />
    <h5>Comments (@comments.Count)</h5>

    @foreach (CommentDto comment in comments)
    {
        <div class="border rounded p-2 mb-2">
            <strong>@AuthorName(comment.UserId)</strong>
            <small class="text-muted">@comment.Created.ToLocalTime().ToString("g")</small>
            <div>@comment.Body</div>
        </div>
    }

    <div class="mt-3">
        <textarea class="form-control" rows="3" placeholder="Write a comment..." @bind="newComment"></textarea>
        <button class="btn btn-primary mt-2" @onclick="AddCommentAsync">Add comment</button>
        @if (!string.IsNullOrEmpty(commentError))
        {
            <p class="text-danger mt-2">@commentError</p>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Hardcoded until login is added in the next assignment
    private const int CurrentUserId = 1;

    private PostDto? post;
    private List<CommentDto> comments = new();
    private Dictionary<int, string> userNames = new();
    private string newComment = "";
    private string? error;
    private string? commentError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id);
            comments = await PostService.GetCommentsAsync(Id);
            List<UserDto> users = await UserService.GetUsersAsync();
            userNames = users.ToDictionary(u => u.Id, u => u.UserName);
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        commentError = null;
        if (string.IsNullOrWhiteSpace(newComment))
        {
            commentError = "Comment cannot be empty.";
            return;
        }

        try
        {
            CommentDto created = await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = newComment,
                UserId = CurrentUserId,
                PostId = Id
            });
            comments.Add(created);
            newComment = "";
        }
        catch (Exception e)
        {
            commentError = e.Message;
        }
    }

    private string AuthorName(int userId) =>
        userNames.TryGetValue(userId, out string? name) ? name : "unknown";
}
